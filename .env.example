# ==============================================================================
# PodcastForge Studio - Plantilla de variables de entorno
# Copia este archivo a .env y rellena tus claves antes de arrancar.
# ==============================================================================

# --- OpenRouter (Obligatorio para análisis editorial y dirección visual) ---
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_EDITORIAL=deepseek/deepseek-v3.2
OPENROUTER_MODEL_EDITORIAL_STRONG=google/gemini-2.5-flash
OPENROUTER_MODEL_IMAGE=google/gemini-2.5-flash-image

# --- Stock gratuito (al menos una recomendada) ---
PEXELS_API_KEY=tu-clave-pexels-aqui
PIXABAY_API_KEY=tu-clave-pixabay-aqui

# --- Whisper Local (100% gratuito en tu equipo) ---
WHISPER_DRAFT_MODEL=base
WHISPER_PRECISION_MODEL=medium
WHISPER_DEVICE=auto          # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8    # int8 | float16 | float32

# --- Rendimiento local y servidor ---
FFMPEG_THREADS=4
HOST=127.0.0.1
PORT=8000

# --- Rutas opcionales (dejar vacío para autodetección) ---
FFMPEG_PATH=
FFPROBE_PATH=
